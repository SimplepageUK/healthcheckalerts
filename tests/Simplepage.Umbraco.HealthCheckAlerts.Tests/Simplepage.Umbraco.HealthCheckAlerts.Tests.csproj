<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Restores Umbraco at the 17.0.0 floor; its transitive advisories are Umbraco's to fix, see the package csproj. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- The fakes implement Umbraco interfaces that carry [Obsolete] members. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real package project, so the tests run against exactly what ships. It restores
         Umbraco.Cms.Core at the floor of its range (17.0.0), which is the oldest Umbraco we claim to support. -->
    <ProjectReference Include="../../src/Simplepage.Umbraco.HealthCheckAlerts/Simplepage.Umbraco.HealthCheckAlerts.csproj" />
  </ItemGroup>
</Project>
